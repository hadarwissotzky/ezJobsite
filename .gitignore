# deps / build
node_modules/
.expo/
dist/
build/
*.log

# env / secrets — never commit
.env
.env.*
# ...except the example, which carries NO VALUES and is the only way anyone else
# can start this repo. `.env.*` silently swallowed it — which is exactly why no
# .env.example existed: every attempt to add one was refused without a word.
# The negation is deliberate and narrow: .env, .env.local, .env.production stay
# ignored; only this one literal name is allowed back.
!.env.example
*.pem
*.keystore
google-services.json
GoogleService-Info.plist

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# supabase local
supabase/.branches
supabase/.temp

# repo-import leftover (safe to delete)
_import.tar
.gstack/
apps/worker/node_modules/

# CodeGraph's local index. Derived from the source, rebuilt by the watcher, and large.
.codegraph/

# Ad-hoc Metro-inspector (CDP) helpers written during a debugging session — evaluate an
# expression on the attached phone, grab a screenshot. Genuinely useful, genuinely
# throwaway: each is a one-liner pile that assumes a device is attached on :8081. They
# are dotfiles in apps/mobile so they never appear in a listing; ignoring them keeps a
# private debugging kit private rather than pretending it is tooling anyone can rely on.
apps/mobile/.c2.cjs
apps/mobile/.fx.cjs
apps/mobile/.go.cjs
apps/mobile/.shot.cjs
